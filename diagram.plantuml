@startuml

!theme plain
top to bottom direction
skinparam linetype ortho

class AbsoluteQuantifier {
  + AbsoluteQuantifier(String, FuzzySet):
}
class ClassicSet {
  + ClassicSet(Set<Double>):
  + ClassicSet(double, double):
  - minBound: double
  - discreteElements: Set<Double>
  - isContinuous: boolean
  - maxBound: double
  + contains(double): boolean
   maxBound: double
   discreteElements: Set<Double>
   minBound: double
   isContinuous: boolean
}

class FuzzySet {
  + FuzzySet(ClassicSet, MembershipFunction):
  - membershipFunction: MembershipFunction
  - universe: ClassicSet
  + union(FuzzySet): FuzzySet
  + intersect(FuzzySet): FuzzySet
  + getMembership(double): double
  + complement(): FuzzySet
   membershipFunction: MembershipFunction
   universe: ClassicSet
}
class GaussianMembershipFunction {
  + GaussianMembershipFunction(double, double):
  - mean: double
  - sigma: double
  + getMembership(double): double
  + getMean(): double
  + getSigma(): double
}
class LinguisticSummaryDTO {
  + LinguisticSummaryDTO(String):
  - summaryText: String
  - overallScore: double
  - qualityMeasures: Map<Integer, Double>
  + setMeasure(int, double): void
  + toString(): String
  + getMeasure(int): double
   qualityMeasures: Map<Integer, Double>
   summaryText: String
   overallScore: double
}
class LinguisticVariable {
  + LinguisticVariable(String):
  - attributeName: String
  - labels: Map<String, FuzzySet>
  + addLabel(String, FuzzySet): void
  + getLabelSet(String): FuzzySet
   labelsMap: Map<String, FuzzySet>
   attributeName: String
   labels: Set<String>
}
interface MembershipFunction << interface >> {
  + getMembership(double): double
}
class OptimalSummaryOptimizer {
  + OptimalSummaryOptimizer():
  + optimize(List<LinguisticSummaryDTO>, Map<Integer, Double>): List<LinguisticSummaryDTO>
}
class QualityEvaluator {
  + QualityEvaluator():
  + evaluateT2(List<FuzzySet>): double
  + evaluateT5(List<FuzzySet>): double
  + evaluateT9(List<FuzzySet>): double
  + evaluateT1(List<DataEntity>, Quantifier, FuzzySet, List<FuzzySet>): double
  - degreeOfImprecision(FuzzySet): double
  + evaluateT7(Quantifier): double
  + evaluateT4(List<FuzzySet>): double
  + evaluateT10(FuzzySet): double
  + evaluateT8(List<FuzzySet>): double
  - evaluateSingleMembership(DataEntity, FuzzySet): double
  + evaluateT11(FuzzySet): double
  + evaluateT3(List<DataEntity>, FuzzySet, List<FuzzySet>): double
  + evaluateT6(Quantifier): double
  - evaluateCombinedMembership(DataEntity, List<FuzzySet>): double
}
class Quantifier {
  + Quantifier(String, FuzzySet):
  # name: String
  # fuzzySet: FuzzySet
  + getMembership(double): double
   name: String
   fuzzySet: FuzzySet
}
class RelativeQuantifier {
  + RelativeQuantifier(String, FuzzySet):
}
class FuzzyStatement {
  + FuzzyStatement(String, String, FuzzySet):
  - attributeName: String
  - label: String
  - fuzzySet: FuzzySet
  + getAttributeName(): String
  + getLabel(): String
  + getFuzzySet(): FuzzySet
}
class SubjectPartitioner {
  + SubjectPartitioner():
  + split(List<DataEntity>, Predicate<DataEntity>): List<List<DataEntity>>
  + filter(List<DataEntity>, Predicate<DataEntity>): List<DataEntity>
}
class SummaryGenerator {
  + SummaryGenerator():
  + generateSingleSubject(List<DataEntity>, List<Quantifier>, List<FuzzySet>, List<LinguisticVariable>): List<LinguisticSummaryDTO>
  + generateMultiSubject(List<DataEntity>, List<DataEntity>, String, String, List<Quantifier>, List<LinguisticVariable>): List<LinguisticSummaryDTO>
  - buildSentence(String, FuzzySet, String, String): String
}
class TrapezoidalMembershipFunction {
  + TrapezoidalMembershipFunction(double, double, double, double):
  - c: double
  - a: double
  - b: double
  - d: double
  + getMembership(double): double
  + getA(): double
  + getB(): double
  + getC(): double
  + getD(): double
}
class TriangularMembershipFunction {
  + TriangularMembershipFunction(double, double, double):
  - c: double
  - b: double
  - a: double
  + getMembership(double): double
  + getA(): double
  + getB(): double
  + getC(): double
}

AbsoluteQuantifier             -[#000082,plain]-^  Quantifier
GaussianMembershipFunction     -[#008200,dashed]-^  MembershipFunction
RelativeQuantifier             -[#000082,plain]-^  Quantifier
TrapezoidalMembershipFunction  -[#008200,dashed]-^  MembershipFunction
TriangularMembershipFunction   -[#008200,dashed]-^  MembershipFunction

FuzzySet               *--  ClassicSet              : universe
FuzzySet               *--  MembershipFunction      : membershipFunction
Quantifier             *--  FuzzySet                : fuzzySet
LinguisticVariable     o--  FuzzySet                : labels *

FuzzyStatement         *--  FuzzySet                : fuzzySet

SummaryGenerator       ..>  Quantifier              : «uses»
SummaryGenerator       ..>  FuzzyStatement           : «uses»
SummaryGenerator       ..>  LinguisticSummaryDTO    : «creates»
SummaryGenerator       ..>  QualityEvaluator        : «calls»
QualityEvaluator       ..>  Quantifier              : «uses»
QualityEvaluator       ..>  FuzzyStatement           : «uses»
QualityEvaluator       ..>  FuzzySet                : «uses»
OptimalSummaryOptimizer ..> LinguisticSummaryDTO    : «ranks»

@enduml
